@model ListingFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label fw-semibold"></label>
        <input asp-for="Title" class="form-control" placeholder="e.g. Byzantine Gold Solidus Coin" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Category" class="form-label fw-semibold"></label>
        <select asp-for="Category" asp-items="ListingOptions.CategoryItems" class="form-select"></select>
        <span asp-validation-for="Category" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="StartingPrice" class="form-label fw-semibold"></label>
        <input asp-for="StartingPrice" type="number" step="0.01" class="form-control" placeholder="250" />
        <span asp-validation-for="StartingPrice" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="EvidenceType" class="form-label fw-semibold"></label>
        <select asp-for="EvidenceType" asp-items="ListingOptions.EvidenceTypeItems" class="form-select">
            <option value="">-- Select evidence type --</option>
        </select>
        <span asp-validation-for="EvidenceType" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="VideoUrl" class="form-label fw-semibold"></label>
        <input asp-for="VideoUrl" class="form-control" placeholder="https://vimeo.com/your-proof-video" />
        <div class="form-text">Continuous footage showing the physical features and a date timestamp.</div>
        <span asp-validation-for="VideoUrl" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
        <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label fw-semibold"></label>
        <textarea asp-for="Description" rows="4" class="form-control"
                  placeholder="Background history, provenance, physical flaws, weight..."></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="ReviewerId" class="form-label fw-semibold"></label>
        @if (Model.Reviewers.Count == 0)
        {
            <div class="alert alert-warning py-2 small mb-0">
                No reviewers are available right now. Please try again later.
            </div>
        }
        else
        {
            <select asp-for="ReviewerId" asp-items="Model.Reviewers" class="form-select">
                <option value="">-- Select a reviewer --</option>
            </select>
        }
        <span asp-validation-for="ReviewerId" class="text-danger small"></span>
    </div>
</div>