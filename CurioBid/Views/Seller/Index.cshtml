@model IEnumerable<Listing>
@{
    ViewData["Title"] = "Seller Hub";

    var total = Model.Count();
    var pending = Model.Count(l => l.Status == ListingStatus.Pending);
    var needsProof = Model.Count(l => l.Status == ListingStatus.NeedsProof);
    var approved = Model.Count(l => l.Status == ListingStatus.Approved);
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold m-0">My Listings</h2>
            <p class="text-muted m-0">Submit items for authenticator review and track their status.</p>
        </div>
        <a asp-action="Create" class="btn btn-warning fw-bold px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> New Listing
        </a>
    </div>

    <partial name="_Alerts" />

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <small class="text-muted fw-semibold">Total Submitted</small>
                <h3 class="fw-bold text-dark m-0">@total</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <small class="text-muted fw-semibold">Pending Review</small>
                <h3 class="fw-bold text-warning m-0">@pending</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <small class="text-muted fw-semibold">Need More Proof</small>
                <h3 class="fw-bold text-info m-0">@needsProof</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <small class="text-muted fw-semibold">Approved</small>
                <h3 class="fw-bold text-success m-0">@approved</h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold m-0"><i class="bi bi-journal-text me-2"></i>Submission Status</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Reviewer</th>
                        <th>Start Price</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                You haven't submitted anything yet. Click "New Listing" to start.
                            </td>
                        </tr>
                    }
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@l.Title</td>
                            <td>@l.Category</td>
                            <td class="small">@l.Reviewer?.FullName</td>
                            <td>$@(l.StartingPrice.ToString("N2"))</td>
                            <td><partial name="_StatusBadge" model="l.Status" /></td>
                            <td class="small text-muted">@l.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@l.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                                @if (l.Status == ListingStatus.NeedsProof)
                                {
                                    <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-sm btn-warning fw-semibold">
                                        <i class="bi bi-pencil-square me-1"></i>Add Proof
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>