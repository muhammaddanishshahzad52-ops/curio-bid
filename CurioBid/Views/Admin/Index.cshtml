@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Admin Panel";
    ViewData["RoleLabel"] = "Administrator";
    ViewData["NavBg"] = "bg-cb-dark";
    ViewData["BrandClass"] = "text-orange";
    ViewData["BadgeClass"] = "badge-orange";
}

<div class="container my-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold m-0">System Administration</h2>
            <p class="text-muted m-0">Platform operational workflows, deposit escrow management, and audit logs.</p>
        </div>
        <button class="btn btn-orange fw-bold shadow-sm" onclick="addNewUserPrompt()">
            <i class="bi bi-person-plus me-1"></i> Add System User
        </button>
    </div>

    <!-- System Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-cb-dark text-white">
                <small class="text-muted fw-semibold">Total Registered Users</small>
                <h3 class="fw-bold text-orange m-0" id="metric-users">1,240</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-cb-dark text-white">
                <small class="text-muted fw-semibold">Active Bidding Escrows</small>
                <h3 class="fw-bold text-success m-0" id="metric-escrow">$18,450</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-cb-dark text-white">
                <small class="text-muted fw-semibold">Open Disputes</small>
                <h3 class="fw-bold text-orange m-0" id="metric-disputes">1</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-cb-dark text-white">
                <small class="text-muted fw-semibold">System Uptime</small>
                <h3 class="fw-bold text-info m-0">99.9%</h3>
            </div>
        </div>
    </div>

    <!-- Management Sections -->
    <div class="row g-4">
        <!-- User & Role Hierarchy -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold m-0"><i class="bi bi-people me-2"></i>User Roles &amp; Accounts</h5>
                    <span class="badge bg-light text-dark border" id="user-count-badge">3 Accounts</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>User Email</th>
                                <th>Assigned Role</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="user-table-body">
                            <!-- Rows rendered by JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Dispute Resolution -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold m-0"><i class="bi bi-shield-exclamation me-2"></i>Dispute &amp; Escrow Settlement</h5>
                    <span class="badge badge-orange-subtle" id="dispute-count-badge">1 Active</span>
                </div>
                <div class="card-body" id="dispute-container">
                    <!-- Disputes rendered by JavaScript -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Modify User Account Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editUserIndex">
                <div class="mb-3">
                    <label class="form-label fw-semibold">User Email</label>
                    <input type="text" class="form-control" id="editUserEmail" readonly>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Assign Role</label>
                    <select class="form-select" id="editUserRole">
                        <option value="Buyer">Buyer</option>
                        <option value="Seller">Seller</option>
                        <option value="Reviewer">Reviewer</option>
                        <option value="Admin">Administrator</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Account Status</label>
                    <select class="form-select" id="editUserStatus">
                        <option value="Active">Active</option>
                        <option value="Verified">Verified</option>
                        <option value="Suspended">Suspended</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-orange fw-bold" onclick="saveUserRoleChange()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --cb-orange: #e06d10;
            --cb-orange-dark: #b85408;
            --cb-orange-light: #fff5ed;
            --cb-orange-subtle: #fde6d2;
            --cb-dark: #1c1917;
        }

        .bg-cb-dark {
            background-color: var(--cb-dark) !important;
        }

        .text-orange {
            color: var(--cb-orange) !important;
        }

        .btn-orange {
            background-color: var(--cb-orange) !important;
            border-color: var(--cb-orange) !important;
            color: #ffffff !important;
        }

        .btn-orange:hover {
            background-color: var(--cb-orange-dark) !important;
            border-color: var(--cb-orange-dark) !important;
            color: #ffffff !important;
        }

        .btn-outline-orange {
            color: var(--cb-orange) !important;
            border-color: var(--cb-orange) !important;
        }

        .btn-outline-orange:hover {
            background-color: var(--cb-orange) !important;
            color: #ffffff !important;
        }

        .badge-orange {
            background-color: var(--cb-orange) !important;
            color: #ffffff !important;
        }

        .badge-orange-subtle {
            background-color: var(--cb-orange-subtle) !important;
            color: var(--cb-orange-dark) !important;
            border: 1px solid rgba(224, 109, 16, 0.25);
        }
    </style>
}

@section Scripts {
    <script>
        // Initial state datasets
        const defaultUsers = [
            { email: "alex.bidder@@mail.com", role: "Buyer", status: "Active" },
            { email: "seller.antiques@@mail.com", role: "Seller", status: "Verified" },
            { email: "inspector.mike@@curiobid.com", role: "Reviewer", status: "Active" }
        ];

        const defaultDisputes = [
            {
                id: "DSP-401",
                item: "Roman Silver Denarius (138 AD)",
                reason: "Non-shipment claim by winning bidder within 48h timeframe.",
                time: "Opened 2h ago",
                status: "Open",
                amount: "$450.00"
            }
        ];

        function getUsers() {
            const data = localStorage.getItem('curioBidAdminUsers');
            return data ? JSON.parse(data) : defaultUsers;
        }

        function saveUsers(users) {
            localStorage.setItem('curioBidAdminUsers', JSON.stringify(users));
        }

        function getDisputes() {
            const data = localStorage.getItem('curioBidAdminDisputes');
            return data ? JSON.parse(data) : defaultDisputes;
        }

        function saveDisputes(disputes) {
            localStorage.setItem('curioBidAdminDisputes', JSON.stringify(disputes));
        }

        function renderAdminDashboard() {
            const users = getUsers();
            const disputes = getDisputes();

            // Render metrics
            document.getElementById('metric-users').textContent = (1240 + users.length - 3).toLocaleString();
            document.getElementById('metric-disputes').textContent = disputes.filter(d => d.status === 'Open').length;
            document.getElementById('user-count-badge').textContent = `${users.length} Accounts`;
            document.getElementById('dispute-count-badge').textContent = `${disputes.filter(d => d.status === 'Open').length} Active`;

            // Render users table
            const userTbody = document.getElementById('user-table-body');
            userTbody.innerHTML = users.map((u, index) => {
                let roleBadge = 'bg-secondary';
                if (u.role === 'Seller') roleBadge = 'bg-primary';
                else if (u.role === 'Reviewer') roleBadge = 'badge-orange';
                else if (u.role === 'Admin') roleBadge = 'bg-dark';

                let statusBadge = u.status === 'Suspended' ? 'bg-danger' : 'bg-success';

                return `
                            <tr>
                                <td class="fw-semibold small">${u.email}</td>
                                <td><span class="badge ${roleBadge}">${u.role}</span></td>
                                <td><span class="badge ${statusBadge}">${u.status}</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-dark" onclick="openEditRoleModal(${index})">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </button>
                                </td>
                            </tr>
                        `;
            }).join('');

            // Render disputes queue
            const disputeBox = document.getElementById('dispute-container');
            const openDisputes = disputes.filter(d => d.status === 'Open');

            if (openDisputes.length === 0) {
                disputeBox.innerHTML = `
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
                                <h6 class="fw-bold">No Pending Disputes</h6>
                                <p class="small mb-0">All commitment deposits & escrow settlements are in good standing.</p>
                            </div>
                        `;
                return;
            }

            disputeBox.innerHTML = openDisputes.map(d => `
                        <div class="border rounded-3 p-3 mb-3 bg-light border-orange">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-orange"><i class="bi bi-exclamation-diamond me-1"></i>Dispute #${d.id}</strong>
                                <small class="text-muted font-monospace">${d.time}</small>
                            </div>
                            <p class="small text-dark mb-1"><strong>Item:</strong> ${d.item} (${d.amount})</p>
                            <p class="small text-muted mb-3">${d.reason}</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-danger" onclick="resolveDispute('${d.id}', 'hold')">
                                    <i class="bi bi-lock me-1"></i>Hold Seller Payout
                                </button>
                                <button class="btn btn-sm btn-outline-success" onclick="resolveDispute('${d.id}', 'refund')">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Refund Bidder Deposit
                                </button>
                            </div>
                        </div>
                    `).join('');
        }

        function openEditRoleModal(index) {
            const users = getUsers();
            const user = users[index];
            document.getElementById('editUserIndex').value = index;
            document.getElementById('editUserEmail').value = user.email;
            document.getElementById('editUserRole').value = user.role;
            document.getElementById('editUserStatus').value = user.status;

            const modal = new bootstrap.Modal(document.getElementById('editRoleModal'));
            modal.show();
        }

        function saveUserRoleChange() {
            const index = document.getElementById('editUserIndex').value;
            const users = getUsers();

            users[index].role = document.getElementById('editUserRole').value;
            users[index].status = document.getElementById('editUserStatus').value;

            saveUsers(users);
            renderAdminDashboard();

            const modalEl = document.getElementById('editRoleModal');
            bootstrap.Modal.getInstance(modalEl).hide();
        }

        function addNewUserPrompt() {
            const email = prompt("Enter new user email:");
            if (!email || !email.trim()) return;

            const users = getUsers();
            users.unshift({
                email: email.trim(),
                role: "Buyer",
                status: "Active"
            });
            saveUsers(users);
            renderAdminDashboard();
        }

        function resolveDispute(id, actionType) {
            const disputes = getDisputes();
            const target = disputes.find(d => d.id === id);
            if (!target) return;

            if (actionType === 'hold') {
                alert(`Seller payout held for Dispute #${id}. Escalated to arbitration.`);
            } else {
                alert(`Bidder deposit refunded in full for Dispute #${id}.`);
            }

            target.status = 'Resolved';
            saveDisputes(disputes);
            renderAdminDashboard();
        }

        // Initialize page
        renderAdminDashboard();
    </script>
}