@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Log In";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">

            <div class="mb-3 text-center">
                <a asp-controller="Home" asp-action="Index" class="text-light text-decoration-none small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Public Auctions
                </a>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h3 class="fw-bold text-dark mb-1">
                            <i class="bi bi-bank text-warning me-2"></i>CurioBid
                        </h3>
                        <p class="text-muted small">Sign in to manage listings or place bids</p>
                    </div>

                    <div id="alertBox" class="alert alert-danger d-none p-2 small text-center" role="alert"></div>

                    <form id="loginForm" novalidate>
                        <div class="mb-3">
                            <label for="emailInput" class="form-label fw-semibold small">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" id="emailInput" placeholder="name@@example.com" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="passwordInput" class="form-label fw-semibold small">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control" id="passwordInput" placeholder="••••••••" required>
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="bi bi-eye" id="toggleIcon"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="remember">
                                <label class="form-check-label small text-muted" for="remember">Remember me</label>
                            </div>
                            <a href="#" onclick="alert('Password reset link sent to demo account!'); return false;"
                               class="small text-decoration-none text-warning fw-semibold">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mb-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </form>

                    <hr class="my-4">

                    <div class="text-center">
                        <p class="small text-muted mb-2 fw-semibold">Quick Demo Login As:</p>
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <button type="button" class="btn btn-outline-dark" onclick="loginAsRole('buyer')">Buyer</button>
                            <button type="button" class="btn btn-outline-dark" onclick="loginAsRole('seller')">Seller</button>
                            <button type="button" class="btn btn-outline-dark" onclick="loginAsRole('reviewer')">Reviewer</button>
                            <button type="button" class="btn btn-outline-dark" onclick="loginAsRole('admin')">Admin</button>
                        </div>
                    </div>
                </div>

                <div class="card-footer text-center bg-light py-3 border-0 rounded-bottom-4">
                    <small class="text-muted">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Signup" class="fw-bold text-decoration-none text-warning">Sign Up</a>
                    </small>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const roleRoutes = {
            buyer: '@Url.Action("Index", "Home")',
            seller: '@Url.Action("Index", "Seller")',
            reviewer: '@Url.Action("Index", "Reviewer")',
            admin: '@Url.Action("Index", "Admin")'
        };

        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('toggleIcon');

        togglePassword.addEventListener('click', () => {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            toggleIcon.classList.toggle('bi-eye');
            toggleIcon.classList.toggle('bi-eye-slash');
        });

        const loginForm = document.getElementById('loginForm');
        const alertBox = document.getElementById('alertBox');

        loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('emailInput').value.trim();
            const password = passwordInput.value.trim();

            if (!email || !password) {
                alertBox.textContent = 'Please enter both email and password.';
                alertBox.classList.remove('d-none');
                return;
            }

            let role = 'buyer';
            if (email.includes('seller')) role = 'seller';
            else if (email.includes('reviewer')) role = 'reviewer';
            else if (email.includes('admin')) role = 'admin';

            localStorage.setItem('curioBidUser', JSON.stringify({
                email: email,
                role: role,
                loggedInAt: new Date().toISOString()
            }));

            window.location.href = roleRoutes[role];
        });

        function loginAsRole(role) {
            localStorage.setItem('curioBidUser', JSON.stringify({
                email: `${role}@@curiobid.com`,
                role: role,
                loggedInAt: new Date().toISOString()
            }));
            window.location.href = roleRoutes[role];
        }
    </script>
}