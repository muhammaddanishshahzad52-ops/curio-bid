@model Listing
@{
    ViewData["Title"] = "Review #CB-" + Model.Id;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <a asp-action="Index" class="small text-decoration-none text-muted">
                <i class="bi bi-arrow-left me-1"></i>Back to queue
            </a>

            <partial name="_Alerts" />

            <div class="card border-0 shadow-sm mt-2">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold m-0"><i class="bi bi-search me-2"></i>Review #CB-@Model.Id</h5>
                    <partial name="_StatusBadge" model="Model.Status" />
                </div>

                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h4 class="fw-bold mb-1">@Model.Title</h4>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-person me-1"></i>Submitted by @Model.Seller?.FullName
                                on @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
                            </p>
                        </div>
                        <span class="badge bg-secondary fs-6">@Model.Category</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ReviewerNote))
                    {
                        <div class="alert alert-secondary py-2 small">
                            <strong>Your previous note:</strong> @Model.ReviewerNote
                            <br />This listing was resubmitted by the seller.
                        </div>
                    }

                    <p class="bg-light p-3 rounded border my-3">@Model.Description</p>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block">Starting price</small>
                                <strong class="fs-5">$@(Model.StartingPrice.ToString("N2"))</strong>
                                <small class="text-muted d-block mt-2">Evidence type</small>
                                <strong>@Model.EvidenceType</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="bg-dark text-white rounded p-3 h-100 text-center d-flex flex-column justify-content-center">
                                <i class="bi bi-play-circle fs-1 text-warning"></i>
                                <a href="@Model.VideoUrl" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-outline-warning btn-sm mt-2">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Open Video Proof
                                </a>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded mb-3" style="max-height: 280px;" />
                    }

                    <hr />

                    <form asp-action="Review" method="post">
                        <input type="hidden" name="ListingId" value="@Model.Id" />

                        <label class="form-label fw-semibold" for="Note">Note to the seller</label>
                        <textarea name="Note" id="Note" rows="3" maxlength="500" class="form-control"
                                  placeholder="Required when rejecting or asking for more proof. Optional when approving."></textarea>

                        <div class="d-flex gap-2 mt-4 flex-wrap">
                            <button type="submit" name="decision" value="approve"
                                    class="btn btn-success fw-bold flex-grow-1 py-2"
                                    onclick="return confirm('Approve this listing and start its 24-hour auction window?');">
                                <i class="bi bi-check-lg me-1"></i>Approve
                            </button>
                            <button type="submit" name="decision" value="needsproof"
                                    class="btn btn-warning fw-bold flex-grow-1 py-2">
                                <i class="bi bi-question-circle me-1"></i>Request More Proof
                            </button>
                            <button type="submit" name="decision" value="reject"
                                    class="btn btn-danger fw-bold flex-grow-1 py-2"
                                    onclick="return confirm('Reject this listing?');">
                                <i class="bi bi-x-lg me-1"></i>Reject
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>