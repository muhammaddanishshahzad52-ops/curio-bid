@model ReviewerQueueViewModel
@{
    ViewData["Title"] = "Reviewer Queue";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold m-0">My Verification Queue</h2>
            <p class="text-muted m-0">Listings that sellers sent to you for review.</p>
        </div>
        <span class="badge bg-danger fs-6 px-3 py-2 shadow-sm">@Model.Pending.Count Awaiting Review</span>
    </div>

    <partial name="_Alerts" />

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold m-0"><i class="bi bi-list-task me-2"></i>Pending</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ref</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Seller</th>
                        <th>Start Price</th>
                        <th>Submitted</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Pending.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-shield-check text-success fs-3 d-block mb-1"></i>
                                Your queue is empty.
                            </td>
                        </tr>
                    }
                    @foreach (var l in Model.Pending)
                    {
                        <tr>
                            <td class="font-monospace small">#CB-@l.Id</td>
                            <td class="fw-semibold">@l.Title</td>
                            <td>@l.Category</td>
                            <td class="small">@l.Seller?.FullName</td>
                            <td>$@(l.StartingPrice.ToString("N2"))</td>
                            <td class="small text-muted">@l.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Review" asp-route-id="@l.Id" class="btn btn-sm btn-primary fw-semibold">
                                    <i class="bi bi-search me-1"></i>Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold m-0"><i class="bi bi-clock-history me-2"></i>Recently Decided</h5>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ref</th>
                        <th>Title</th>
                        <th>Seller</th>
                        <th>Decision</th>
                        <th>Decided</th>
                        <th>Your note</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Reviewed.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Nothing decided yet.</td>
                        </tr>
                    }
                    @foreach (var l in Model.Reviewed)
                    {
                        <tr>
                            <td class="font-monospace small">#CB-@l.Id</td>
                            <td class="fw-semibold">@l.Title</td>
                            <td class="small">@l.Seller?.FullName</td>
                            <td><partial name="_StatusBadge" model="l.Status" /></td>
                            <td class="small text-muted">@l.ReviewedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="small text-muted" title="@l.ReviewerNote">
                                @(l.ReviewerNote?.Length > 60 ? l.ReviewerNote[..60] + "…" : l.ReviewerNote)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>