<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | CurioBid</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark @(ViewData["NavBg"] ?? "bg-dark") sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold @(ViewData["BrandClass"] ?? "text-warning")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bank me-2"></i>CurioBid
                <span class="badge @(ViewData["BadgeClass"] ?? "bg-secondary") font-monospace fs-6 ms-1">@ViewData["RoleLabel"]</span>
            </a>
            <div class="ms-auto d-flex gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-eye me-1"></i>Public View
                </a>
                <button onclick="handleLogout()" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </div>
        </div>
    </nav>

    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>