@model UserListItemViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="fw-bold m-0"><i class="bi bi-exclamation-triangle me-2"></i>Delete User</h5>
                </div>
                <div class="card-body p-4">
                    <p>Are you sure you want to permanently delete this account? This cannot be undone.</p>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                        <dt class="col-sm-4">Role</dt>
                        <dd class="col-sm-8">@Model.Role</dd>
                    </dl>
                </div>
                <div class="card-footer bg-white">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger fw-bold">Yes, Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>