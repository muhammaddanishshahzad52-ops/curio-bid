@model IEnumerable<UserListItemViewModel>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Status</th>
                <th>Joined</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No users found.</td>
                </tr>
            }
            @foreach (var u in Model)
            {
                var roleBadge = u.Role switch
                {
                    "Admin" => "bg-dark",
                    "Reviewer" => "bg-info",
                    _ => "bg-secondary"
                };

                <tr>
                    <td class="fw-semibold">@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.PhoneNumber</td>
                    <td><span class="badge @roleBadge">@u.Role</span></td>
                    <td>
                        @if (u.IsSuspended)
                        {
                            <span class="badge bg-danger">Suspended</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td class="small text-muted">
                        @(u.CreatedAt.Year > 1 ? u.CreatedAt.ToString("yyyy-MM-dd") : "—")
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>